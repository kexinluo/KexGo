{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KexGo",
  "version": "0.1.0",
  "identifier": "com.kexgo.player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KexGo",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": true,
        "backgroundColor": "#0c0e0c",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src 'self' data: blob:; font-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "极简本地音乐播放器，带快速歌词对轴。",
    "longDescription": "KexGo 是一个安静的本地音乐播放器。导入你自己的音乐，自动关联 LRC 和封面，在线寻找开放歌词；找不到时，用空格键跟着唱一遍就能完成逐行对轴。",
    "copyright": "KexGo"
  }
}
